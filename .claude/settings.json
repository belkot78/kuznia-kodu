{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/dane/**)",
      "Read(**/lokalne.yaml)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.db)",
      "Read(**/*.sqlite*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git * --output*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ]
  }
}
