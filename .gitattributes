# Skrypty sh (hooki git i instalator): zawsze LF (CRLF psuje shebang)
.githooks/* text eol=lf
szablon/.githooks/* text eol=lf
instaluj/*.sh text eol=lf
hooks/*.sh text eol=lf
# Lacznik (git apply) musi miec LF, inaczej kontekst sie nie zgadza
*.patch text eol=lf

# Wszystkie pliki tekstowe zawsze LF (CRLF psuje naglowek agenta pluginu)
* text=auto eol=lf
