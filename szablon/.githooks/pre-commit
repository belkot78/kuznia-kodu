#!/bin/sh
# Hook pre-commit: blokuje commit, jesli w indeksie sa sekrety lub dane (tools/przeglad.py --indeks).
# Reguly sa te same co w tools/przeglad.py (kontrola b), liczone na zawartosci indeksu git: jedno zrodlo regul.
# Nie czyta dane/ (zakazane foldery sa odrzucane po nazwie). Brak Pythona = blokada (fail closed).
# Falszywy alarm: popraw kod (np. nazwe zmiennej) albo dopisz wyjatek w tools/przeglad_konfig.py (przez Pawla),
# nie omijaj kontroli (bez --no-verify).
# Wlaczenie (Pawel, raz na klon): git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
NAZWA=$(basename "$PWD")
PY=""
# Kolejnosc: venv agenta (<home>/.venvs/<nazwa-repo>), .venv repo, potem python z PATH.
for K in "$HOME/.venvs/$NAZWA/Scripts/python.exe" "$HOME/.venvs/$NAZWA/bin/python" \
         ".venv/Scripts/python.exe" ".venv/bin/python"; do
    if [ -x "$K" ]; then PY="$K"; break; fi
done
if [ -z "$PY" ]; then
    for K in python3 python py; do
        if command -v "$K" >/dev/null 2>&1; then PY="$K"; break; fi
    done
fi
if [ -z "$PY" ] || ! "$PY" -c "import sys" >/dev/null 2>&1; then
    echo "COMMIT ZABLOKOWANY - BLAD INTERPRETERA, nie wykryty sekret. Kontrola sekretow nie zostala wykonana." >&2
    echo "Napraw interpreter (venv agenta, .venv repo lub python w PATH); nie omijaj kontroli." >&2
    exit 1
fi
"$PY" tools/przeglad.py --indeks
kod=$?
if [ "$kod" -ne 0 ]; then
    echo "" >&2
    echo "COMMIT ZABLOKOWANY - mozliwy sekret lub dane (szczegoly wyzej, wartosci nie sa wypisywane)." >&2
    echo "Wycofaj plik: git restore --staged <plik>. Nie wklejaj tresci sekretu do czatu." >&2
    exit 1
fi
exit 0
